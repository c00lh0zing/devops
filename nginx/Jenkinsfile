SYNGX_USER="syngxdevops"

pipeline {
    agent {
        node {
            label 'masterLin'
        }
    }

    parameters {
        string(name: 'RMCMD', defaultValue: 'id', description: "Выполнить команду на ноде. Пример: <b>sudo systemctl status syngx | journalctl -xe | cat /opt/syngx/conf/syngx.con")
        choice(name: 'DEST_HOST', choices: ['10.119.121.116', '10.109.36.102'], description: "IP адрес ноды")
        booleanParam(name: 'CFG01', defaultValue: false, description: '<b>[10.119.121.116] Disable - 10.119.121.44 </b>| Enable - 10.109.37.176')
        booleanParam(name: 'CFG02', defaultValue: false, description: '<b>[10.119.121.116] Disable - 10.109.37.176 </b>| Enable - 10.119.121.44')
        booleanParam(name: 'CFG03', defaultValue: false, description: '[10.119.121.116] Enable - 10.119.121.44 | Enable - 10.109.37.176')

        booleanParam(name: 'CFG04', defaultValue: false, description: '<b>[10.109.36.102] Disable - 10.119.121.44 </b>| Enable - 10.109.37.176')
        booleanParam(name: 'CFG05', defaultValue: false, description: '<b>[10.109.36.102] Disable - 10.109.37.176 </b>| Enable - 10.119.121.44')
        booleanParam(name: 'CFG06', defaultValue: false, description: '[10.109.36.102] Enable - 10.119.121.44 | Enable - 10.109.37.176')
    }

    stages {

        stage('Validate params') {
            steps {
                script {
                    def allowedCfgByHost = [
                        '10.119.121.116': ['CFG01', 'CFG02', 'CFG03'],
                        '10.109.36.102' : ['CFG04', 'CFG05', 'CFG06']
                    ]

                    def selectedCfgFlags = ['CFG01', 'CFG02', 'CFG03', 'CFG04', 'CFG05', 'CFG06'].findAll { cfgName ->
                        return params[cfgName]
                    }

                    def allowedCfgFlags = allowedCfgByHost[params.DEST_HOST] ?: []
                    def invalidSelectedCfgFlags = selectedCfgFlags.findAll { cfgName ->
                        return !allowedCfgFlags.contains(cfgName)
                    }

                    if (invalidSelectedCfgFlags) {
                        error("Для DEST_HOST=${params.DEST_HOST} недопустимы флаги: ${invalidSelectedCfgFlags.join(', ')}. Разрешено: ${allowedCfgFlags.join(', ')}")
                    }

                    def selectedMode = selectedCfgFlags ? selectedCfgFlags.join(', ') : 'none'
                    echo "Validate params: DEST_HOST=${params.DEST_HOST}, selected mode=${selectedMode}"
                }
            }
        }

        stage('Custom tasks') {
            steps {
              script {
                        currentBuild.displayName = "${DEST_HOST}"
                }
                script{
                    // Использование ссылочного креда с типом Vault SSH private key with signed public key Credential
                    withCredentials([[$class: 'VaultSignedSSHKeyCredentialBinding',
                        credentialsId: 'ssh_syngxdevops2',          // ID ссылочного креда с типом Vault SSH private key with signed public key Credential
                        privateKeyVar: 'SSH_PRIVATE_KEY',           // Переменная, где будет храниться путь к файлу со значением приватного ключа
                        passphraseVar: 'SSH_PRIVATE_KEY_PASS']]) {  // Переменная, где будет хранится значение парольной фразы
                 
                        sshagent([]){
                            sh '''
                            set +x
                            echo -e "#!/bin/sh\necho \\$SSH_PRIVATE_KEY_PASS" > send_ps.sh
                            chmod +x ./send_ps.sh
                            DISPLAY=1 SSH_ASKPASS="./send_ps.sh" ssh-add $SSH_PRIVATE_KEY < /dev/null
                            '''
                            sh """
                            ssh -o StrictHostKeyChecking=no -o CertificateFile=$SIGNED_SSH_PUBLIC_KEY -i $SSH_PRIVATE_KEY $SYNGX_USER@$DEST_HOST 'ip a'
                            ssh -o StrictHostKeyChecking=no -o CertificateFile=$SIGNED_SSH_PUBLIC_KEY -i $SSH_PRIVATE_KEY $SYNGX_USER@$DEST_HOST 'ls -lan /opt/syngx/'
                            ssh -o StrictHostKeyChecking=no -o CertificateFile=$SIGNED_SSH_PUBLIC_KEY -i $SSH_PRIVATE_KEY $SYNGX_USER@$DEST_HOST 'ls -lan /opt/syngx/conf'
                            ssh -o StrictHostKeyChecking=no -o CertificateFile=$SIGNED_SSH_PUBLIC_KEY -i $SSH_PRIVATE_KEY $SYNGX_USER@$DEST_HOST '${RMCMD}'
                            """
                        }
                    }
                }
            }
        }

        stage('Deploy: CFG01') {
            when {
                expression { params.CFG01 }
            }
            steps {
               script {
                        currentBuild.displayName = "${DEST_HOST} CFG01"
                }
                script{
                    // Использование ссылочного креда с типом Vault SSH private key with signed public key Credential
                    withCredentials([[$class: 'VaultSignedSSHKeyCredentialBinding',
                        credentialsId: 'ssh_syngxdevops2',          // ID ссылочного креда с типом Vault SSH private key with signed public key Credential
                        privateKeyVar: 'SSH_PRIVATE_KEY',           // Переменная, где будет храниться путь к файлу со значением приватного ключа
                        passphraseVar: 'SSH_PRIVATE_KEY_PASS']]) {  // Переменная, где будет хранится значение парольной фразы
                 
                        sshagent([]){
                            sh '''
                            set +x
                            echo -e "#!/bin/sh\necho \\$SSH_PRIVATE_KEY_PASS" > send_ps.sh
                            chmod +x ./send_ps.sh
                            DISPLAY=1 SSH_ASKPASS="./send_ps.sh" ssh-add $SSH_PRIVATE_KEY < /dev/null
                            '''
                            sh """
                                ssh -o StrictHostKeyChecking=no -o CertificateFile=$SIGNED_SSH_PUBLIC_KEY -i $SSH_PRIVATE_KEY $SYNGX_USER@$DEST_HOST 'cat /opt/syngx/conf/syngx.conf'
                                ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o CertificateFile=$SIGNED_SSH_PUBLIC_KEY -i $SSH_PRIVATE_KEY $SYNGX_USER@$DEST_HOST 'cp /opt/syngx/conf/syngx.conf /opt/syngx/conf/syngx.conf_`date +"%Y%m%d_%H%M"` | true'
                                ls -la
                                scp -i $SSH_PRIVATE_KEY -o StrictHostKeyChecking=no ./syngx_cfg/cfg/CFG01/syngx.conf $SYNGX_USER@$DEST_HOST:/opt/syngx/conf/
                                ssh -o StrictHostKeyChecking=no -o CertificateFile=$SIGNED_SSH_PUBLIC_KEY -i $SSH_PRIVATE_KEY $SYNGX_USER@$DEST_HOST 'sudo systemctl restart syngx'
                            """
                        }
                    }
                }
            }
        }

        stage('Deploy: CFG02') {
            when {
                expression { params.CFG02 }
            }
