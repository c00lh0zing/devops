                                ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o CertificateFile=$SIGNED_SSH_PUBLIC_KEY -i $SSH_PRIVATE_KEY $SYNGX_USER@$DEST_HOST 'cp /opt/syngx/conf/syngx.conf /opt/syngx/conf/syngx.conf_`date +"%Y%m%d_%H%M"` | true'
                                ls -la
                                scp -i $SSH_PRIVATE_KEY -o StrictHostKeyChecking=no ./syngx_cfg/cfg/CFG02/syngx.conf $SYNGX_USER@$DEST_HOST:/opt/syngx/conf/
                                ssh -o StrictHostKeyChecking=no -o CertificateFile=$SIGNED_SSH_PUBLIC_KEY -i $SSH_PRIVATE_KEY $SYNGX_USER@$DEST_HOST 'sudo systemctl restart syngx'
